{
  "attachmentFolder": "u",
  "config": {
    "newLinkFormat": "absolute",
    "trashOption": "local"
  },
  "corePlugins": [
    { "id": "bases", "name": "Bases", "enabled": true },
    {
      "id": "templates",
      "name": "Templates",
      "enabled": false,
      "onlyWith": { "id": "templater-obsidian", "name": "Templater" }
    },
    { "id": "zk-prefixer", "name": "Unique note creator", "enabled": false },
    {
      "id": "backlink",
      "name": "Backlinks",
      "enabled": false,
      "onlyWith": { "id": "backlinks-full-view", "name": "Backlinks Full View" }
    }
  ],
  "hotkeys": [
    {
      "command": "app:go-back",
      "name": "Navigate back",
      "keys": [
        { "modifiers": ["Mod", "Alt"], "key": "ArrowLeft" },
        { "modifiers": ["Mod"], "key": "[" }
      ]
    },
    {
      "command": "app:go-forward",
      "name": "Navigate forward",
      "keys": [
        { "modifiers": ["Mod", "Alt"], "key": "ArrowRight" },
        { "modifiers": ["Mod"], "key": "]" }
      ]
    },
    {
      "command": "templater-obsidian:create-new-note-from-template",
      "name": "Templater: Create new note from template",
      "keys": [{ "modifiers": ["Alt"], "key": "N" }]
    },
    {
      "command": "templater-obsidian:insert-templater",
      "name": "Templater: Open insert template modal",
      "keys": []
    }
  ]
}
